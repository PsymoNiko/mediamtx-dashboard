# MediaMTX Dashboard Environment Variables
# Copy this file to .env and update the values

# Browser-facing MediaMTX API URL. Docker publishes this port to the host,
# so localhost is reachable by the browser while Docker service names are not.
NEXT_PUBLIC_MEDIAMTX_API_URL=http://localhost:9997

# MediaMTX HLS URL (for video streaming)
NEXT_PUBLIC_MEDIAMTX_HLS_URL=http://localhost:8888

# MediaMTX WebRTC additional hosts (for local development)
MTX_WEBRTCADDITIONALHOSTS=localhost
